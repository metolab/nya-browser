+// Chrome on Windows encodes AAC through Media Foundation, which takes these
+// parameters only.
+bool NyaClaimsWindowsAac(const AudioEncoderTraits::ParsedConfig& config) {
+  const media::AudioEncoder::Options& options = config.options;
+  if (!nya::EmulatesWindows() || options.codec != media::AudioCodec::kAAC) {
+    return false;
