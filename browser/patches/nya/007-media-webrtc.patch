 String MediaStreamTrackImpl::label() const {
-  return component_->GetSourceName();
+  const String name = component_->GetSourceName();
+  const std::optional<const MediaStreamDevice> source_device = device();
+  if (name.empty() || !source_device) {
+    return name;
+  }
+  const bool audio =
+      source_device->type == mojom::blink::MediaStreamType::DEVICE_AUDIO_CAPTURE;
+  if (!audio && source_device->type !=
+                    mojom::blink::MediaStreamType::DEVICE_VIDEO_CAPTURE) {
+    return name;
+  }
+  // Same names enumerateDevices() reports for the spoofed capture devices.
+  for (const auto& row : nya::SpoofedMediaDevices()) {
+    if (row.kind != (audio ? "audioinput" : "videoinput") || row.label.empty()) {
+      continue;
+    }
+    const String label = String::FromUtf8(row.label);
+    if (audio) {
+      std::string prefix;
+      if (source_device->id == "default") {
+        prefix = nya::MediaDefaultPrefix();
+      } else if (source_device->id == "communications") {
+        prefix = nya::MediaCommunicationsPrefix();
+      }
+      if (!prefix.empty()) {
+        return nya::EmulatesWindows() ? String::FromUtf8(prefix) + " - " + label
+                                      : String::FromUtf8(prefix);
+      }
+    }
+    return label;
+  }
+  return name;
 }
 
