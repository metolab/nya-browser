+// Nya Windows emulation on a GPU host: Chrome on Windows decodes HEVC
+// Main/Main10 through D3D11 there.
+bool NyaClaimsWindowsHevc(VideoCodecProfile profile) {
+  static const bool claim = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    return cmd && cmd->GetSwitchValueASCII("nya-os") == "windows" &&
+           cmd->HasSwitch("nya-os-hw-video");
+  }();
+  return claim &&
+         (profile == HEVCPROFILE_MAIN || profile == HEVCPROFILE_MAIN10);
+}
