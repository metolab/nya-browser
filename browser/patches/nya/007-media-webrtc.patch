+// Windows GPUs decode H.264/VP9/HEVC and encode HEVC in hardware for WebRTC.
+bool NyaWebrtcHwCodec(const std::optional<webrtc::SdpVideoFormat>& format,
+                      bool decode) {
+  if (!format || !nya::EmulatesWindowsHwVideo()) {
+    return false;
+  }
+  std::string name = format->name;
+  for (char& c : name) {
+    c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+  }
+  return name == "H265" || (decode && (name == "H264" || name == "VP9"));
+}
