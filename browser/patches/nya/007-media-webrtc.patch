+// After a grant Chrome lists each audio kind as "default" (on Windows also
+// "communications") and then the endpoint, all sharing the endpoint's group
+// id. Windows labels them "<prefix> - <endpoint>", Linux "Default" alone.
+MediaDeviceInfoVector NyaMediaDevices(
+    const MediaDeviceInfoVector& devices,
+    const std::vector<nya::MediaDeviceSpoof>& spoofed) {
+  const String default_prefix = String::FromUtf8(nya::MediaDefaultPrefix());
+  const String comm_prefix = String::FromUtf8(nya::MediaCommunicationsPrefix());
+  MediaDeviceInfoVector out;
+  for (mojom::blink::MediaDeviceType type :
+       {mojom::blink::MediaDeviceType::kMediaAudioInput,
+        mojom::blink::MediaDeviceType::kMediaVideoInput,
+        mojom::blink::MediaDeviceType::kMediaAudioOutput}) {
+    const char* kind =
+        type == mojom::blink::MediaDeviceType::kMediaAudioInput   ? "audioinput"
+        : type == mojom::blink::MediaDeviceType::kMediaVideoInput ? "videoinput"
+                                                                  : "audiooutput";
+    MediaDeviceInfo* first = nullptr;
+    MediaDeviceInfo* physical = nullptr;
+    for (const auto& device : devices) {
+      if (device->DeviceType() != type) {
+        continue;
+      }
+      if (!first) {
+        first = device.Get();
+      }
+      if (!physical && device->deviceId() != "default" &&
+          device->deviceId() != "communications") {
+        physical = device.Get();
+      }
+    }
+    if (!first) {
+      continue;
+    }
+    // Without permission the browser already masks the list to one
+    // anonymous entry per kind.
+    if (first->label().empty()) {
+      for (const auto& device : devices) {
+        if (device->DeviceType() == type) {
+          out.push_back(device);
+        }
+      }
+      continue;
+    }
+    if (!physical) {
+      physical = first;
+    }
+    String label = physical->label();
+    for (const auto& row : spoofed) {
+      if (row.kind == kind && !row.label.empty()) {
+        label = String::FromUtf8(row.label);
+        break;
+      }
+    }
+    const String group = physical->groupId();
+    auto add = [&](const String& id, const String& text) {
+      if (type == mojom::blink::MediaDeviceType::kMediaAudioOutput) {
+        out.push_back(
+            MakeGarbageCollected<MediaDeviceInfo>(id, text, group, type));
+      } else {
+        out.push_back(
+            MakeGarbageCollected<InputDeviceInfo>(id, text, group, type));
+      }
+    };
+    if (type != mojom::blink::MediaDeviceType::kMediaVideoInput) {
+      add("default", nya::EmulatesWindows() ? default_prefix + " - " + label
+                                            : default_prefix);
+      if (!comm_prefix.empty()) {
+        add("communications", comm_prefix + " - " + label);
+      }
+    }
+    add(physical->deviceId(), label);
+  }
+  return out;
+}
