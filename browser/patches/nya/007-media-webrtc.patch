+// GPU codecs Chrome on Windows negotiates, claimed under Windows emulation so
+// createOffer() agrees with RTCRtpSender/Receiver.getCapabilities().
+std::vector<webrtc::SdpVideoFormat> NyaHwFormats(bool sender) {
+  std::vector<webrtc::SdpVideoFormat> formats;
+  for (const auto& [mime, fmtp] : nya::WindowsHwRtcCodecs(sender)) {
+    webrtc::CodecParameterMap params;
+    for (std::string_view pair : base::SplitStringPiece(
+             fmtp, ";", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      const size_t eq = pair.find('=');
+      if (eq != std::string_view::npos) {
+        params[std::string(pair.substr(0, eq))] =
+            std::string(pair.substr(eq + 1));
+      }
+    }
+    formats.emplace_back(mime.substr(mime.find('/') + 1), params);
+  }
+  return formats;
+}
+
+std::vector<webrtc::SdpVideoFormat> WithNyaHwFormats(
+    std::vector<webrtc::SdpVideoFormat> formats,
+    bool sender) {
+  return MergeFormats(std::move(formats), NyaHwFormats(sender));
+}
+
+// The software stack backs a claimed H.264 High format with Constrained
+// Baseline (every High decoder decodes it, and FFmpeg decodes High). Claimed
+// HEVC has no software backing and fails over to the next negotiated codec.
+std::optional<webrtc::SdpVideoFormat> NyaSoftwareStandIn(
+    const webrtc::SdpVideoFormat& format,
+    bool sender) {
+  if (!base::EqualsCaseInsensitiveASCII(format.name, webrtc::kH264CodecName) ||
+      !format.IsCodecInList(NyaHwFormats(sender))) {
+    return std::nullopt;
+  }
+  const auto mode = format.parameters.find(webrtc::kH264FmtpPacketizationMode);
+  return webrtc::CreateH264Format(
+      webrtc::H264Profile::kProfileConstrainedBaseline,
+      webrtc::H264Level::kLevel3_1,
+      mode != format.parameters.end() ? mode->second : "1");
+}
