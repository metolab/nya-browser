+void FontMetrics::ApplyNyaWindowsVerticalMetrics(const SkFont& font,
+                                                 SkFontMetrics& metrics) {
+  if (!nya::EmulatesWindows()) {
+    return;
+  }
+  SkTypeface* face = font.getTypeface();
+  if (!face || face->getUnitsPerEm() <= 0) {
+    return;
+  }
+  static const SkFontTableTag kOs2Tag = SkSetFourByteTag('O', 'S', '/', '2');
+  static const SkFontTableTag kHheaTag = SkSetFourByteTag('h', 'h', 'e', 'a');
+  uint8_t os2[78];
+  uint8_t hhea[10];
+  if (face->getTableData(kOs2Tag, 0, sizeof(os2), os2) != sizeof(os2) ||
+      face->getTableData(kHheaTag, 0, sizeof(hhea), hhea) != sizeof(hhea)) {
+    return;
+  }
+  int ascent;
+  int descent;
+  int line_gap;
+  if (NyaReadU16(os2, 62) & 0x80) {
+    // fsSelection USE_TYPO_METRICS.
+    ascent = NyaReadS16(os2, 68);
+    descent = -NyaReadS16(os2, 70);
+    line_gap = NyaReadS16(os2, 72);
+  } else {
+    ascent = NyaReadU16(os2, 74);
+    descent = NyaReadU16(os2, 76);
+    // GDI external leading: whatever hhea spacing exceeds the win extent.
+    line_gap = NyaReadS16(hhea, 4) - NyaReadS16(hhea, 6) +
+               NyaReadS16(hhea, 8) - (ascent + descent);
+  }
+  if (ascent + descent <= 0) {
+    return;
+  }
+  const float scale = font.getSize() / face->getUnitsPerEm();
+  metrics.fAscent = -ascent * scale;
+  metrics.fDescent = descent * scale;
+  metrics.fLeading = std::max(0, line_gap) * scale;
+}
