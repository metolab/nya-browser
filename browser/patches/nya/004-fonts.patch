+uint16_t nya_be16(const uint8_t* p) { return static_cast<uint16_t>((p[0] << 8) | p[1]); }
+
+std::vector<uint8_t> nya_table(const fontations_ffi::BridgeFontRef& font, SkFontTableTag tag) {
+    std::vector<uint8_t> data(fontations_ffi::table_data(font, tag, 0, rust::Slice<uint8_t>()));
+    if (!data.empty()) {
+        data.resize(fontations_ffi::table_data(
+                font, tag, 0, rust::Slice<uint8_t>(data.data(), data.size())));
+    }
+    return data;
+}
