+// GDI-classic measuring applies when a bitmap strike sits at trunc(size)
+// ppem, or anywhere in the gasp range around it when that range is
+// gridfit-only. Returns the GDI ppem (size rounded half up) or 0.
+int nya_gdi_classic_ppem(const fontations_ffi::BridgeFontRef& font,
+                         SkScalar textSize,
+                         SkScalar* gdiTextSize) {
+    const rust::String family = fontations_ffi::family_name(font);
+    const std::string name(family.data(), family.size());
+    if (name == "Calibri" || name == "Courier New") {
+        return 0;
+    }
+    const SkScalar size = SkScalarRoundToScalar(textSize * 64.0f) / 64.0f;
+    if (size < 1) {
+        return 0;
+    }
+    const std::vector<uint8_t> eblc = nya_table(font, SkSetFourByteTag('E', 'B', 'L', 'C'));
+    if (eblc.size() < 8) {
+        return 0;
+    }
+    const int bitmapPPEM = SkScalarTruncToInt(size);
+    int minPPEM = bitmapPPEM;
+    int maxPPEM = bitmapPPEM;
+    const std::vector<uint8_t> gasp = nya_table(font, SkSetFourByteTag('g', 'a', 's', 'p'));
+    if (gasp.size() >= 4 && nya_be16(gasp.data()) <= 1) {
+        const size_t ranges = nya_be16(gasp.data() + 2);
+        int previous = -1;
+        for (size_t i = 0; i < ranges && 8 + 4 * i <= gasp.size(); ++i) {
+            const int rangeMax = nya_be16(gasp.data() + 4 + 4 * i);
+            if (previous < bitmapPPEM && bitmapPPEM <= rangeMax) {
+                if (nya_be16(gasp.data() + 6 + 4 * i) == 1) {
+                    minPPEM = previous + 1;
+                    maxPPEM = rangeMax;
+                }
+                break;
+            }
+            previous = rangeMax;
+        }
+    }
+    const uint32_t strikes = (uint32_t(nya_be16(eblc.data() + 4)) << 16) | nya_be16(eblc.data() + 6);
+    for (uint32_t i = 0; i < strikes && i < 1024 && 8 + 48 * (i + 1) <= eblc.size(); ++i) {
+        const uint8_t* record = eblc.data() + 8 + 48 * i;
+        const int start = nya_be16(record + 40);
+        const int end = nya_be16(record + 42);
+        const int ppemX = record[44];
+        const int ppemY = record[45];
+        if (ppemX == ppemY && minPPEM <= ppemY && ppemY <= maxPPEM && end >= start + 3) {
+            *gdiTextSize = size;
+            return SkScalarFloorToInt(size + 0.5f);
+        }
+    }
+    return 0;
+}
