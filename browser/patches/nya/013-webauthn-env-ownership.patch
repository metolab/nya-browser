+  auto* environment = AuthenticatorEnvironment::GetInstance();
+  if (VirtualAuthenticatorManagerImpl* manager =
+          environment->MaybeGetVirtualAuthenticatorManager(node)) {
+    for (const std::string& id : owned) {
+      manager->RemoveAuthenticator(id);
+    }
+  }
+  environment->ReleaseVirtualAuthenticatorFor(node);
