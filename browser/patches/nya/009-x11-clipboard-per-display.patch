 X11ClipboardOzone::~X11ClipboardOzone() = default;
 
+x11::Connection* X11ClipboardOzone::ActiveConnection() const {
+  if (auto* wm = X11WindowManager::GetInstance()) {
+    if (auto* win = wm->last_active_window()) {
+      return &win->connection();
+    }
+  }
+  return x11::Connection::Get();
+}
+
+XClipboardHelper* X11ClipboardOzone::Helper() {
+  x11::Connection* conn = ActiveConnection();
+  x11::ScopedConnectionBind bind(conn);
+  auto it = helpers_.find(conn);
+  if (it != helpers_.end()) {
+    return it->second.get();
+  }
+  auto helper = std::make_unique<XClipboardHelper>(base::BindRepeating(
+      &X11ClipboardOzone::OnSelectionChanged, base::Unretained(this)));
+  XClipboardHelper* raw = helper.get();
+  helpers_[conn] = std::move(helper);
+  return raw;
+}
