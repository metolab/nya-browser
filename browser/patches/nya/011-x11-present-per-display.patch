 std::map<std::string, std::unique_ptr<Connection>>& ExtraConnections() {
-  static base::NoDestructor<std::map<std::string, std::unique_ptr<Connection>>>
-      extra;
-  return *extra;
+  // Per-thread: the GPU/compositor thread must not share xcb connections
+  // with the UI thread (sequence checker + xcb is not thread-safe).
+  using ExtraMap = std::map<std::string, std::unique_ptr<Connection>>;
+  static base::NoDestructor<base::ThreadLocalOwnedPointer<ExtraMap>> tls;
+  auto& slot = *tls;
+  if (!slot.Get()) {
+    slot.Set(std::make_unique<ExtraMap>());
+  }
+  return *slot.Get();
+}
+
+struct WidgetDisplayMap {
+  base::Lock lock;
+  std::map<uint32_t, std::string> widget_to_display;
+};
+
+WidgetDisplayMap& GetWidgetDisplayMap() {
+  static base::NoDestructor<WidgetDisplayMap> map;
+  return *map;
 }
 
