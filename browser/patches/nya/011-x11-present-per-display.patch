+void Connection::RegisterWidget(uint32_t widget, const std::string& display) {
+  auto& map = GetWidgetDisplayMap();
+  base::AutoLock lock(map.lock);
+  map.widget_to_display[widget] = display;
+}
+
+void Connection::UnregisterWidget(uint32_t widget) {
+  auto& map = GetWidgetDisplayMap();
+  base::AutoLock lock(map.lock);
+  map.widget_to_display.erase(widget);
+}
+
+std::string Connection::DisplayForWidget(uint32_t widget) {
+  auto& map = GetWidgetDisplayMap();
+  base::AutoLock lock(map.lock);
+  auto it = map.widget_to_display.find(widget);
+  if (it == map.widget_to_display.end()) {
+    return std::string();
+  }
+  return it->second;
+}
+
+Connection* Connection::ForWidget(uint32_t widget) {
+  const std::string display = DisplayForWidget(widget);
+  if (display.empty()) {
+    return Get();
+  }
+  // Same server as the process DISPLAY: reuse the pumped primary connection.
+  // A second xcb to the same server on the compositor thread would present
+  // without an event pump and stall after two SHM frames.
+  if (Connection* primary = Primary()) {
+    if (display == primary->DisplayString()) {
+      return Get();
+    }
+  }
+  if (Connection* extra = GetOrCreate(display)) {
+    return extra;
+  }
+  return Get();
+}
+
