 BrowserNativeWidget* BrowserNativeWidgetFactory::Create(
     BrowserWidget* browser_widget,
     BrowserView* browser_view) {
+  if (nya::OneCompositorEnabled() && browser_view && browser_view->browser()) {
+    const std::string& display =
+        browser_view->browser()->create_params().nya_x11_display;
+    if (nya::FindDesktopHost(display)) {
+      // window.open / undocked DevTools / PiP on a display that already has
+      // the session GPU compositor. BrowserNativeWidgetAura is a Desktop
+      // widget and would create a second EGL pbuffer.
+      return new nya::BrowserNativeWidgetChild(browser_widget, browser_view);
+    }
+  }
   return new BrowserNativeWidgetAuraLinux(browser_widget, browser_view);
 }
