 NativeWidgetType GetNativeWidgetTypeForInitParams(
     const views::Widget::InitParams& params) {
+  // One GPU compositor per X display. Extra widgets (menus, bubbles,
+  // security surfaces, helper TYPE_WINDOW) are NativeWidgetAura layers on
+  // that compositor. The factory upgrades NativeWidgetAura to Desktop when
+  // parent/context/child are all unset, so CreateNativeWidget attaches the
+  // host before calling through.
+  if (nya::OneCompositorEnabled()) {
+    if (nya::ShouldHostInExistingCompositor(params) || params.parent ||
+        params.context || params.child) {
+      return NativeWidgetType::kNativeWidgetAura;
+    }
+    if (params.type == views::Widget::InitParams::TYPE_WINDOW ||
+        params.type == views::Widget::InitParams::TYPE_WINDOW_FRAMELESS) {
+      return NativeWidgetType::kDesktopNativeWidgetAura;
+    }
+    return NativeWidgetType::kNativeWidgetAura;
+  }
+
   // If this is a security surface, always use a toplevel window,
   // otherwise it's possible for things like menus to obscure the view.
   if (params.z_order &&
@@ -81,6 +98,27 @@
 views::NativeWidget* ChromeViewsDelegate::CreateNativeWidget(
     views::Widget::InitParams* params,
     views::internal::NativeWidgetDelegate* delegate) {
+  if (nya::OneCompositorEnabled()) {
+    if (gfx::NativeView host = nya::FindDesktopHost(*params)) {
+      if (!params->parent) {
+        params->parent = host;
+      }
+      if (!params->context) {
+        params->context = host;
+      }
+      // TYPE_BUBBLE/POPUP map to WINDOW_TYPE_POPUP, which
+      // DesktopScreenPositionClient already places in screen coordinates even
+      // as children. TYPE_MENU/TOOLTIP do not: forcing child=true parents them
+      // to the bookmark bubble and treats screen bounds as bubble-relative, so
+      // the folder combobox opens off-screen. Keep those top-level transients
+      // on the browser compositor (still NativeWidgetAura, no extra X window).
+      if (params->type != views::Widget::InitParams::TYPE_MENU &&
+          params->type != views::Widget::InitParams::TYPE_TOOLTIP) {
+        params->child = true;
+      }
+      params->use_accelerated_widget_override = false;
+    }
+  }
   return ::CreateNativeWidget(GetNativeWidgetTypeForInitParams(*params), params,
                               delegate);
 }
