@@ -0,0 +1,56 @@
+// Copyright 2026 Nya Browser
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CHROME_BROWSER_UI_NYA_NYA_BROWSER_NATIVE_WIDGET_H_
+#define CHROME_BROWSER_UI_NYA_NYA_BROWSER_NATIVE_WIDGET_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/views/frame/browser_native_widget.h"
+#include "ui/views/widget/native_widget_aura.h"
+
+class BrowserView;
+class BrowserWidget;
+
+namespace nya {
+
+// Extra Browser windows (window.open, undocked DevTools, PiP) on an X
+// display that already has a GPU compositor. Hosted as NativeWidgetAura
+// layers so they stay GPU-composited without a second EGL pbuffer.
+class BrowserNativeWidgetChild : public views::NativeWidgetAura,
+                                 public BrowserNativeWidget {
+ public:
+  BrowserNativeWidgetChild(BrowserWidget* browser_widget,
+                           BrowserView* browser_view);
+  BrowserNativeWidgetChild(const BrowserNativeWidgetChild&) = delete;
+  BrowserNativeWidgetChild& operator=(const BrowserNativeWidgetChild&) = delete;
+
+  // views::NativeWidgetAura:
+  void ClientDestroyedWidget() override;
+
+  // BrowserNativeWidget:
+  views::Widget::InitParams GetWidgetParams(
+      views::Widget::InitParams::Ownership ownership) override;
+  bool UseCustomFrame() const override;
+  bool UsesNativeSystemMenu() const override;
+  bool ShouldSaveWindowPlacement() const override;
+  void GetWindowPlacement(
+      gfx::Rect* bounds,
+      ui::mojom::WindowShowState* show_state) const override;
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      const input::NativeWebKeyboardEvent& event) override;
+  bool HandleKeyboardEvent(
+      const input::NativeWebKeyboardEvent& event) override;
+  bool ShouldRestorePreviousBrowserWidgetState() const override;
+  bool ShouldUseInitialVisibleOnAllWorkspaces() const override;
+
+ protected:
+  ~BrowserNativeWidgetChild() override;
+
+ private:
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<BrowserWidget> browser_widget_;
+};
+
+}  // namespace nya
+
+#endif  // CHROME_BROWSER_UI_NYA_NYA_BROWSER_NATIVE_WIDGET_H_
diff --git a/chrome/browser/ui/nya/nya_browser_native_widget.cc b/chrome/browser/ui/nya/nya_browser_native_widget.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/nya/nya_browser_native_widget.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 Nya Browser
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/ui/nya/nya_browser_native_widget.h"
+
+#include <string>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/nya/nya_one_compositor.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/browser_widget.h"
+#include "content/public/browser/keyboard_event_processing_result.h"
+#include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/views/widget/widget.h"
+
+namespace nya {
+
+BrowserNativeWidgetChild::BrowserNativeWidgetChild(
+    BrowserWidget* browser_widget,
+    BrowserView* browser_view)
+    : views::NativeWidgetAura(browser_widget),
+      browser_view_(browser_view),
+      browser_widget_(browser_widget) {}
+
+BrowserNativeWidgetChild::~BrowserNativeWidgetChild() = default;
+
+void BrowserNativeWidgetChild::ClientDestroyedWidget() {
+  browser_widget_ = nullptr;
+  browser_view_ = nullptr;
+  NativeWidgetAura::ClientDestroyedWidget();
+}
+
+views::Widget::InitParams BrowserNativeWidgetChild::GetWidgetParams(
+    views::Widget::InitParams::Ownership ownership) {
+  views::Widget::InitParams params(ownership);
+  params.native_widget = this;
+  params.remove_standard_frame = true;
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+
+  std::string display;
+  if (browser_view_ && browser_view_->browser()) {
+    display = browser_view_->browser()->create_params().nya_x11_display;
+  }
+  gfx::NativeView host = FindDesktopHost(display);
+  DCHECK(host) << "Extra browser windows require an existing GPU compositor";
+  params.parent = host;
+  params.context = host;
+  // Transient (not child=true): views treats this as top-level so BrowserView
+  // layout stays correct, while NativeWidgetAura still paints into the host
+  // compositor. child=true would make screen bounds relative to a bubble.
+  params.child = false;
+  params.x11_display = display;
+  return params;
+}
+
+bool BrowserNativeWidgetChild::UseCustomFrame() const {
+  return true;
+}
+
+bool BrowserNativeWidgetChild::UsesNativeSystemMenu() const {
+  return false;
+}
+
+bool BrowserNativeWidgetChild::ShouldSaveWindowPlacement() const {
+  return false;
+}
+
+void BrowserNativeWidgetChild::GetWindowPlacement(
+    gfx::Rect* bounds,
+    ui::mojom::WindowShowState* show_state) const {
+  NativeWidgetAura::GetWindowPlacement(bounds, show_state);
+}
+
+content::KeyboardEventProcessingResult
+BrowserNativeWidgetChild::PreHandleKeyboardEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  return content::KeyboardEventProcessingResult::NOT_HANDLED;
+}
+
+bool BrowserNativeWidgetChild::HandleKeyboardEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  return false;
+}
+
+bool BrowserNativeWidgetChild::ShouldRestorePreviousBrowserWidgetState()
+    const {
+  return true;
+}
+
+bool BrowserNativeWidgetChild::ShouldUseInitialVisibleOnAllWorkspaces() const {
+  return false;
+}
+
+}  // namespace nya
