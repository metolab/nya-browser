+bool IsNyaInWindowPopupType(views::Widget::InitParams::Type type) {
+  return type == views::Widget::InitParams::TYPE_BUBBLE ||
+         type == views::Widget::InitParams::TYPE_POPUP ||
+         type == views::Widget::InitParams::TYPE_MENU ||
+         type == views::Widget::InitParams::TYPE_TOOLTIP;
+}
+
+bool NyaHostPopupsInParent() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kNyaX11MultiDisplay);
+}
+
 NativeWidgetType GetNativeWidgetTypeForInitParams(
     const views::Widget::InitParams& params) {
+  // Xvfb + in-process GPU cannot present a second AcceleratedWidget (frozen
+  // UI + leftover XGrabPointer). Host chrome popups as child Aura windows
+  // of the browser compositor. Security surfaces too: in this product the
+  // browser is maximized, so an in-window prompt cannot be covered by
+  // another X window.
+  if (NyaHostPopupsInParent() && IsNyaInWindowPopupType(params.type) &&
+      (params.parent || params.context || params.child)) {
+    return NativeWidgetType::kNativeWidgetAura;
+  }
+
   // If this is a security surface, always use a toplevel window,
   // otherwise it's possible for things like menus to obscure the view.
   if (params.z_order &&
@@ -81,6 +105,11 @@
 views::NativeWidget* ChromeViewsDelegate::CreateNativeWidget(
     views::Widget::InitParams* params,
     views::internal::NativeWidgetDelegate* delegate) {
+  if (NyaHostPopupsInParent() && IsNyaInWindowPopupType(params->type) &&
+      (params->parent || params->context)) {
+    params->child = true;
+    params->use_accelerated_widget_override = false;
+  }
   return ::CreateNativeWidget(GetNativeWidgetTypeForInitParams(*params), params,
                               delegate);
 }
