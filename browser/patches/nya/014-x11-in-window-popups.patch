+// Copyright 2026 Nya Browser
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CHROME_BROWSER_UI_NYA_NYA_ONE_COMPOSITOR_H_
+#define CHROME_BROWSER_UI_NYA_NYA_ONE_COMPOSITOR_H_
+
+#include <string>
+
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/widget/widget.h"
+
+namespace nya {
+
+// --nya-x11-multi-display: Xvfb + in-process GPU can present exactly one
+// AcceleratedWidget (EGL readback compositor) per X display. Extra chrome
+// UI must be NativeWidgetAura layers on that compositor — still GPU
+// rasterized, no second EGL pbuffer, no software compositor.
+bool OneCompositorEnabled();
+
+// Desktop host already open on |x11_display| (empty = primary). Null if this
+// would be the first AcceleratedWidget on that X server.
+gfx::NativeView FindDesktopHost(const std::string& x11_display);
+
+// Prefer params.parent / params.context; otherwise search by x11_display.
+gfx::NativeView FindDesktopHost(const views::Widget::InitParams& params);
+
+// True when this widget must not create a second Desktop AcceleratedWidget.
+bool ShouldHostInExistingCompositor(const views::Widget::InitParams& params);
+
+}  // namespace nya
+
+#endif  // CHROME_BROWSER_UI_NYA_NYA_ONE_COMPOSITOR_H_
diff --git a/chrome/browser/ui/nya/nya_one_compositor.cc b/chrome/browser/ui/nya/nya_one_compositor.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/nya/nya_one_compositor.cc
@@ -0,0 +1,53 @@
+// Copyright 2026 Nya Browser
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/ui/nya/nya_one_compositor.h"
+
+#include "base/command_line.h"
+#include "components/ungoogled/ungoogled_switches.h"
+#include "ui/aura/window.h"
+#include "ui/views/widget/desktop_aura/desktop_window_tree_host_platform.h"
+#include "ui/views/widget/widget.h"
+
+namespace nya {
+
+bool OneCompositorEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kNyaX11MultiDisplay);
+}
+
+gfx::NativeView FindDesktopHost(const std::string& x11_display) {
+  for (aura::Window* window :
+       views::DesktopWindowTreeHostPlatform::GetAllOpenWindows()) {
+    views::Widget* widget = views::Widget::GetWidgetForNativeView(window);
+    if (!widget) {
+      widget = views::Widget::GetWidgetForNativeWindow(window);
+    }
+    if (!widget) {
+      continue;
+    }
+    if (widget->x11_display() == x11_display) {
+      return window;
+    }
+  }
+  return nullptr;
+}
+
+gfx::NativeView FindDesktopHost(const views::Widget::InitParams& params) {
+  if (params.parent) {
+    return params.parent;
+  }
+  if (params.context) {
+    return params.context;
+  }
+  return FindDesktopHost(params.x11_display);
+}
+
+bool ShouldHostInExistingCompositor(const views::Widget::InitParams& params) {
+  if (!OneCompositorEnabled()) {
+    return false;
+  }
+  return FindDesktopHost(params) != nullptr;
+}
+
+}  // namespace nya
diff --git a/chrome/browser/ui/nya/nya_browser_native_widget.h b/chrome/browser/ui/nya/nya_browser_native_widget.h
