+namespace {
+
+// Windows 10/11 light-theme system colors (GetSysColor defaults). Dark-scheme
+// colors are Blink's defaults on every platform except Highlight.
+std::optional<Color> NyaWindowsSystemColor(
+    CSSValueID css_value_id,
+    mojom::blink::ColorScheme color_scheme) {
+  if (!nya::EmulatesWindows()) {
+    return std::nullopt;
+  }
+  if (color_scheme == mojom::blink::ColorScheme::kDark) {
+    if (css_value_id == CSSValueID::kHighlight) {
+      return Color::FromRGB(25, 103, 210);
+    }
+    return std::nullopt;
+  }
+  switch (css_value_id) {
+    case CSSValueID::kActivetext:
+    case CSSValueID::kLinktext:
+    case CSSValueID::kVisitedtext:
+      return Color::FromRGB(0, 102, 204);
+    case CSSValueID::kButtonface:
+    case CSSValueID::kButtonhighlight:
+    case CSSValueID::kButtonshadow:
+    case CSSValueID::kThreedface:
+      return Color::FromRGB(240, 240, 240);
+    case CSSValueID::kGraytext:
+      return Color::FromRGB(109, 109, 109);
+    case CSSValueID::kHighlight:
+      return Color::FromRGB(0, 120, 212);
+    default:
+      return std::nullopt;
+  }
+}
+
+}  // namespace
+
 Color LayoutTheme::SystemColor(CSSValueID css_value_id,
                                mojom::blink::ColorScheme color_scheme,
                                const ui::ColorProvider* color_provider,
                                bool can_expose_accent_color) const {
+  if (std::optional<Color> nya_color =
+          NyaWindowsSystemColor(css_value_id, color_scheme)) {
+    return *nya_color;
+  }
   if (color_provider && !WebTestSupport::IsRunningWebTest()) {
     return SystemColorFromColorProvider(
         css_value_id, color_scheme, color_provider, can_expose_accent_color);
