+// Nya Windows emulation: values ANGLE's D3D11 backend reports on NVIDIA
+// GeForce instead of the Linux GL driver's.
+bool NyaWindowsD3D11(gpu::gles2::GLES2Interface* gl) {
+  if (!nya::EmulatesWindows() || !gl) {
+    return false;
+  }
+  const char* renderer =
+      reinterpret_cast<const char*>(gl->GetString(GL_RENDERER));
+  return renderer && nya::EmulatesWindowsGpu(renderer);
+}
