 #include "third_party/blink/public/common/features.h"
 
 namespace blink {
 
+namespace {
+
+// Same bounds as nya::DeviceMemory() so headers and navigator agree.
+float NyaDeviceMemoryOverride() {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd || !cmd->HasSwitch(switches::kNyaDeviceMemory)) {
+    return 0.0f;
+  }
+  double value = 0;
+  if (!base::StringToDouble(
+          cmd->GetSwitchValueASCII(switches::kNyaDeviceMemory), &value) ||
+      value <= 0 || value > 32) {
+    return 0.0f;
+  }
+  return static_cast<float>(value);
+}
+
+}  // namespace
