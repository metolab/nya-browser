+uint32_t CenterBgr(const std::vector<uint8_t>& buffer, const gfx::Size& size) {
+  if (size.width() <= 0 || size.height() <= 0 || buffer.size() < 4)
+    return 0;
+  const size_t stride = static_cast<size_t>(size.width()) * 4;
+  const size_t off = static_cast<size_t>(size.height() / 2) * stride +
+                     static_cast<size_t>(size.width() / 2) * 4;
+  if (off + 2 >= buffer.size())
+    return 0;
+  return buffer[off] | (buffer[off + 1] << 8) | (buffer[off + 2] << 16);
+}
 
