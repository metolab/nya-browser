+
+void GLSurfaceEglReadback::SetPendingReadbackPixels(
+    base::span<const uint8_t> pixels) {
+  if (pixels_.empty() || pixels.size() != pixels_.size()) {
+    LOG(ERROR) << "nya-present pending-pixels size mismatch have="
