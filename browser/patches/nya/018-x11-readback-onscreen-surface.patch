+}
+
+void GLSurfaceEglReadback::DestroyReadbackFbo() {
+  if (!readback_fbo_ && !readback_texture_)
+    return;
+  if (gl::GLContext::GetCurrent()) {
+    if (readback_fbo_)
+      glDeleteFramebuffersEXT(1, &readback_fbo_);
+    if (readback_texture_)
+      glDeleteTextures(1, &readback_texture_);
+  }
+  readback_fbo_ = 0;
+  readback_texture_ = 0;
+  readback_fbo_size_ = gfx::Size();
+}
+
+bool GLSurfaceEglReadback::EnsureReadbackFbo(const gfx::Size& size) {
+  if (readback_fbo_ && readback_fbo_size_ == size)
+    return true;
+  DestroyReadbackFbo();
+  if (size.IsEmpty())
+    return true;
+  if (!gl::GLContext::GetCurrent()) {
+    LOG(ERROR) << "nya-present readback-fbo without current GL context";
+    return false;
+  }
+
+  GLuint texture = 0;
+  GLuint fbo = 0;
+  glGenTextures(1, &texture);
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, size.width(), size.height(), 0,
+               GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+
+  glGenFramebuffersEXT(1, &fbo);
+  GLint prev_fbo = 0;
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &prev_fbo);
+  glBindFramebufferEXT(GL_FRAMEBUFFER, fbo);
+  glFramebufferTexture2DEXT(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                            texture, 0);
+  const GLenum status = glCheckFramebufferStatusEXT(GL_FRAMEBUFFER);
+  glBindFramebufferEXT(GL_FRAMEBUFFER, prev_fbo);
+  glBindTexture(GL_TEXTURE_2D, 0);
+  if (status != GL_FRAMEBUFFER_COMPLETE) {
+    LOG(ERROR) << "nya-present readback-fbo incomplete status=" << status
+               << " size=" << size.ToString();
+    glDeleteFramebuffersEXT(1, &fbo);
+    glDeleteTextures(1, &texture);
+    return false;
+  }
+
+  readback_texture_ = texture;
+  readback_fbo_ = fbo;
+  readback_fbo_size_ = size;
+  LOG(ERROR) << "nya-present readback-fbo id=" << readback_fbo_
+             << " tex=" << readback_texture_ << " size=" << size.ToString();
+  return true;
+}
