+namespace {
+
+bool GenericFamilyName(const std::string& lower) {
+  return lower == "serif" || lower == "sans-serif" || lower == "monospace" ||
+         lower == "cursive" || lower == "fantasy" || lower == "system-ui" ||
+         lower == "emoji" || lower == "math" || lower == "fangsong" ||
+         lower == "ui-serif" || lower == "ui-sans-serif" ||
+         lower == "ui-monospace" || lower == "ui-rounded" ||
+         lower == "-webkit-body" || lower == "-webkit-standard" ||
+         lower == "-webkit-pictograph";
+}
+
+std::string LowerCopy(const std::string& in) {
+  std::string out = in;
+  for (char& c : out) {
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  }
+  return out;
+}
+
+}  // namespace
+
+bool HasFontSpoof() {
+  return GetConfig().has_fonts;
+}
+
+bool AllowsFontFamily(const std::string& family) {
+  if (!GetConfig().has_fonts) {
+    return true;
+  }
+  const std::string key = LowerCopy(family);
+  if (key.empty() || GenericFamilyName(key)) {
+    return true;
+  }
+  return GetConfig().font_set.contains(key);
+}
+
+const std::vector<std::string>& SpoofedFontFamilies() {
+  return GetConfig().fonts;
+}
+
+std::string FontPostscriptName(const std::string& family) {
+  if (family == "Arial") {
+    return "ArialMT";
+  }
+  if (family == "Times New Roman") {
+    return "TimesNewRomanPSMT";
+  }
+  if (family == "Courier New") {
+    return "CourierNewPSMT";
+  }
+  if (family == "Calibri") {
+    return "Calibri";
+  }
+  std::string out;
+  out.reserve(family.size());
+  for (char c : family) {
+    if (c != ' ') {
+      out += c;
+    }
+  }
+  return out.empty() ? family : out;
+}
