+void TtsPlatformImplLinux::NyaSpeak(
+    int utterance_id,
+    const std::string& utterance,
+    const UtteranceContinuousParameters& params,
+    base::OnceCallback<void(bool)> on_speak_finished) {
+  const std::u16string text = base::UTF8ToUTF16(utterance);
+  const int length = static_cast<int>(text.size());
+  const double rate = std::clamp(static_cast<double>(params.rate), 0.1, 10.0);
+  const auto is_cjk = [](char16_t ch) {
+    return (ch >= 0x3040 && ch <= 0x30ff) || (ch >= 0x3400 && ch <= 0x9fff) ||
+           (ch >= 0xac00 && ch <= 0xd7af) || (ch >= 0xf900 && ch <= 0xfaff);
+  };
+  const auto is_space = [](char16_t ch) {
+    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' ||
+           ch == 0x3000;
+  };
+  const auto ends_sentence = [](char16_t ch) {
+    return ch == '.' || ch == '!' || ch == '?' || ch == 0x3002 ||
+           ch == 0xff01 || ch == 0xff1f;
+  };
+  const auto is_pause = [&](char16_t ch) {
+    return ends_sentence(ch) || ch == ',' || ch == ';' || ch == ':' ||
+           ch == 0xff0c || ch == 0x3001;
+  };
+
+  // SAPI order: start, then a sentence boundary before the first word of
+  // each sentence and a word boundary per word (per character for CJK), then
+  // end at the full length. Timing is a rough local-engine speaking rate.
+  nya_events_.clear();
+  nya_events_.push_back({0, TTS_EVENT_START, 0, -1});
+  double t = 60;
+  bool new_sentence = true;
+  int i = 0;
+  while (i < length) {
+    const char16_t ch = text[i];
+    if (is_space(ch)) {
+      t += 40;
+      ++i;
+      continue;
+    }
+    if (is_pause(ch)) {
+      t += ends_sentence(ch) ? 260 : 140;
+      new_sentence = new_sentence || ends_sentence(ch);
+      ++i;
+      continue;
+    }
+    int end = i + 1;
+    if (!is_cjk(ch)) {
+      while (end < length && !is_space(text[end]) && !is_cjk(text[end]) &&
+             !is_pause(text[end])) {
+        ++end;
+      }
+    }
+    const int at = static_cast<int>(t / rate);
+    if (new_sentence) {
+      nya_events_.push_back({at, TTS_EVENT_SENTENCE, i, -1});
+      new_sentence = false;
+    }
+    nya_events_.push_back({at, TTS_EVENT_WORD, i, end - i});
+    t += is_cjk(ch) ? 230 : 68.0 * (end - i);
+    i = end;
+  }
+  nya_events_.push_back(
+      {std::max(300, static_cast<int>(t / rate)), TTS_EVENT_END, length, -1});
+  nya_char_index_ = 0;
+  NyaFire(utterance_id, 0);
+  std::move(on_speak_finished).Run(true);
+}
+
+void TtsPlatformImplLinux::NyaFire(int utterance_id, size_t index) {
+  if (utterance_id != utterance_id_ || !is_speaking_ ||
+      index >= nya_events_.size()) {
+    return;
+  }
+  if (paused_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&TtsPlatformImplLinux::NyaFire,
+                       nya_weak_factory_.GetWeakPtr(), utterance_id, index),
+        base::Milliseconds(100));
+    return;
+  }
+  const NyaEvent event = nya_events_[index];
+  nya_char_index_ = event.char_index;
+  if (event.type == TTS_EVENT_END) {
+    is_speaking_ = false;
+    utterance_id_ = kInvalidUtteranceId;
+  } else {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&TtsPlatformImplLinux::NyaFire,
+                       nya_weak_factory_.GetWeakPtr(), utterance_id,
+                       index + 1),
+        base::Milliseconds(nya_events_[index + 1].at_ms - event.at_ms));
+  }
+  TtsController::GetInstance()->OnTtsEvent(utterance_id, event.type,
+                                           event.char_index, event.length,
+                                           std::string());
+}
