+void AudioBuffer::EnsureNyaFarbling() {
+  if (nya_farbled_ || !nya::HasSeed()) {
+    return;
+  }
+  nya_farbled_ = true;
+  for (Member<DOMFloat32Array>& channel : channels_) {
+    if (!channel) {
+      continue;
+    }
+    auto span = channel->AsSpan();
+    nya::FarbleAudio(span.data(), span.size());
+  }
+}
