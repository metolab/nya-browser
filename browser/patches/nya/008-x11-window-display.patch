@@ -31,6 +31,7 @@
 #include "ui/gfx/native_ui_types.h"
 #include "ui/gfx/switches.h"
 #include "ui/gfx/x/atom_cache.h"
+#include "ui/gfx/x/connection.h"
 #include "ui/gfx/x/visual_manager.h"
 #include "ui/linux/linux_ui_delegate.h"
 #include "ui/ozone/common/stub_overlay_manager.h"
@@ -102,6 +103,16 @@
   std::unique_ptr<PlatformWindow> CreatePlatformWindow(
       PlatformWindowDelegate* delegate,
       PlatformWindowInitProperties properties) override {
+    x11::Connection* conn = x11::Connection::Get();
+    if (!properties.x11_display.empty()) {
+      if (auto* extra = x11::Connection::GetOrCreate(properties.x11_display)) {
+        conn = extra;
+      }
+    }
+    x11::ScopedConnectionBind bind(conn);
+    if (ui::X11EventSource::HasInstance()) {
+      ui::X11EventSource::GetInstance()->WatchConnection(conn);
+    }
     auto window = std::make_unique<X11Window>(delegate);
     window->Initialize(std::move(properties));
     return std::move(window);
