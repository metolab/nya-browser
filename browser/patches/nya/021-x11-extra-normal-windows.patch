+    if (widget->IsActive()) {
+      active = window;
+    }
+    if (!x11_display.empty() && widget->x11_display() == x11_display) {
       return window;
     }
   }
-  return nullptr;
+  if (!x11_display.empty()) {
+    return nullptr;
+  }
+  return active ? active : fallback;
