+// Emulated OS identity from the Nya backend; empty when not set or invalid.
+std::string NyaOsSwitch(const char* name) {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (!cmd || !cmd->HasSwitch(name)) {
+    return std::string();
+  }
+  std::string value = cmd->GetSwitchValueASCII(name);
+  if (value.empty() || value.size() > 64 ||
+      !net::HttpUtil::IsValidHeaderValue(value) ||
+      value.find_first_of("\"()\\") != std::string::npos) {
+    return std::string();
+  }
+  return value;
+}
