+void X11EventSource::WatchConnection(x11::Connection* connection) {
+  if (!connection || connection == connection_ ||
+      watched_connections_.contains(connection)) {
+    return;
+  }
+  watched_connections_.insert(connection);
+  InitializeXkb(connection);
+  extra_watchers_.push_back(
+      std::make_unique<X11EventWatcherImpl>(this, connection));
+  extra_watchers_.back()->StartWatching();
+}
