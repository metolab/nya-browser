+// static
+void Connection::Bind(Connection* connection) {
+  GetConnectionOverrideTLS().Set(connection);
+}
+
+// static
+Connection* Connection::GetOverride() {
+  return GetConnectionOverrideTLS().Get();
+}
+
+// static
+Connection* Connection::GetOrCreate(const std::string& display) {
+  Connection* primary = Primary();
+  if (display.empty() || display == primary->DisplayString()) {
+    return primary;
+  }
+  auto& extra = ExtraConnections();
+  auto it = extra.find(display);
+  if (it != extra.end()) {
+    return it->second.get();
+  }
+  auto connection = std::make_unique<Connection>(display);
+  if (!connection->Ready()) {
+    LOG(ERROR) << "Failed to open X display " << display;
+    return nullptr;
+  }
+  Connection* raw = connection.get();
+  extra[display] = std::move(connection);
+  return raw;
+}
+
+// static
+std::vector<std::string> Connection::List() {
+  std::vector<std::string> names;
+  if (Connection* primary = Primary()) {
+    names.push_back(primary->DisplayString());
+  }
+  for (const auto& entry : ExtraConnections()) {
+    names.push_back(entry.first);
+  }
+  return names;
+}
+
+// static
+void Connection::Remove(const std::string& display) {
+  Connection* primary = Primary();
+  if (display.empty() || (primary && display == primary->DisplayString())) {
+    return;
+  }
+  ExtraConnections().erase(display);
+}
+
+ScopedConnectionBind::ScopedConnectionBind(Connection* connection)
+    : previous_(GetConnectionOverrideTLS().Get()) {
+  GetConnectionOverrideTLS().Set(connection);
+}
+
+ScopedConnectionBind::~ScopedConnectionBind() {
+  GetConnectionOverrideTLS().Set(previous_);
+}
