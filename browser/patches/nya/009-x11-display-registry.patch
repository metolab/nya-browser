+// static
+Connection* Connection::GetOrCreate(const std::string& display) {
+  Connection* primary = Primary();
+  if (display.empty() || display == primary->DisplayString()) {
+    return primary;
+  }
+  auto& extra = ExtraConnections();
+  auto it = extra.find(display);
+  if (it != extra.end()) {
+    return it->second.get();
+  }
+  auto connection = std::make_unique<Connection>(display);
+  if (!connection->Ready()) {
+    LOG(ERROR) << "Failed to open X display " << display;
+    return nullptr;
+  }
+  Connection* raw = connection.get();
+  extra[display] = std::move(connection);
+  IndexForDisplay(display);
+  return raw;
+}
+
+// static
+std::vector<std::string> Connection::List() {
+  std::vector<std::string> names;
+  if (Connection* primary = Primary()) {
+    names.push_back(primary->DisplayString());
+  }
+  for (const auto& entry : ExtraConnections()) {
+    names.push_back(entry.first);
+  }
+  return names;
+}
+
+// static
+void Connection::Remove(const std::string& display) {
+  Connection* primary = Primary();
+  if (display.empty() || (primary && display == primary->DisplayString())) {
+    return;
+  }
+  ExtraConnections().erase(display);
+}
+
+uint32_t Connection::IndexForDisplay(const std::string& display) {
+  Connection* primary = Primary();
+  if (display.empty() || (primary && display == primary->DisplayString())) {
+    return 0;
+  }
+  auto& map = GetDisplayIndexMap();
+  base::AutoLock lock(map.lock);
+  auto it = map.display_to_index.find(display);
+  if (it != map.display_to_index.end()) {
+    return it->second;
+  }
+  if (map.index_to_display.empty()) {
+    map.index_to_display.emplace_back(std::string());
+    map.display_to_index[std::string()] = 0;
+  }
+  const uint32_t idx = static_cast<uint32_t>(map.index_to_display.size());
+  CHECK_LT(idx, 16u);
+  map.index_to_display.push_back(display);
+  map.display_to_index[display] = idx;
+  return idx;
+}
+
+std::string Connection::DisplayForIndex(uint32_t index) {
+  if (index == 0) {
+    return std::string();
+  }
+  auto& map = GetDisplayIndexMap();
+  base::AutoLock lock(map.lock);
+  if (index >= map.index_to_display.size()) {
+    return std::string();
+  }
+  return map.index_to_display[index];
+}
+
+uint32_t Connection::EncodeWidget(uint32_t xid, uint32_t display_index) {
+  DCHECK_LE(xid, kWidgetXidMask);
+  DCHECK_LT(display_index, 16u);
+  return (display_index << kWidgetDisplayShift) | (xid & kWidgetXidMask);
+}
+
+uint32_t Connection::WidgetXid(uint32_t widget) {
+  return widget & kWidgetXidMask;
+}
+
+uint32_t Connection::WidgetDisplayIndex(uint32_t widget) {
+  return widget >> kWidgetDisplayShift;
+}
+
+Connection* Connection::ForWidget(uint32_t widget) {
+  const uint32_t index = WidgetDisplayIndex(widget);
+  // Index 0 is the process DISPLAY. Do not use Get(): a ScopedConnectionBind
+  // to an extra server would send primary-widget traffic to the wrong X.
+  if (index == 0) {
+    return Primary();
+  }
+  const std::string display = DisplayForIndex(index);
+  if (display.empty()) {
+    LOG(ERROR) << "No display registered for encoded widget " << widget;
+    return nullptr;
+  }
+  if (Connection* extra = GetOrCreate(display)) {
+    return extra;
+  }
+  LOG(ERROR) << "Failed to open X display " << display << " for widget "
+             << widget;
+  return nullptr;
+}
