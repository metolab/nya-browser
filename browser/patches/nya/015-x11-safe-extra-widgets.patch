new file mode 100644
--- /dev/null
+++ b/ui/ozone/platform/x11/x11_readback_present_cache.h
@@ -0,0 +1,35 @@
+// Copyright 2026 Nya Browser
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef UI_OZONE_PLATFORM_X11_X11_READBACK_PRESENT_CACHE_H_
+#define UI_OZONE_PLATFORM_X11_X11_READBACK_PRESENT_CACHE_H_
+
+#include "base/memory/scoped_refptr.h"
+#include "base/task/single_thread_task_runner.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/gfx/x/xproto.h"
+
+namespace ui {
+
+struct X11ReadbackPresentTarget {
+  x11::Window window = x11::Window::None;
+  x11::GraphicsContext gc{};
+  x11::VisualId visual{};
+  scoped_refptr<base::SingleThreadTaskRunner> ui_runner;
+};
+
+// UI-thread owned GC/visual for EGL-readback present. The GPU thread must not
+// Sync() on an unpumped xcb connection (in-process GPU deadlock / freeze).
+class X11ReadbackPresentCache {
+ public:
+  static void Register(gfx::AcceleratedWidget widget,
+                       const X11ReadbackPresentTarget& target);
+  static void Unregister(gfx::AcceleratedWidget widget);
+  static bool Lookup(gfx::AcceleratedWidget widget,
+                     X11ReadbackPresentTarget* out);
+  static bool Contains(gfx::AcceleratedWidget widget);
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_X11_X11_READBACK_PRESENT_CACHE_H_
diff --git a/ui/ozone/platform/x11/x11_readback_present_cache.cc b/ui/ozone/platform/x11/x11_readback_present_cache.cc
new file mode 100644
--- /dev/null
+++ b/ui/ozone/platform/x11/x11_readback_present_cache.cc
@@ -0,0 +1,58 @@
+// Copyright 2026 Nya Browser
+// Use of this source code is governed by a BSD-style license.
+
+#include "ui/ozone/platform/x11/x11_readback_present_cache.h"
+
+#include <map>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "base/task/single_thread_task_runner.h"
+
+namespace ui {
+namespace {
+
+struct Map {
+  base::Lock lock;
+  std::map<gfx::AcceleratedWidget, X11ReadbackPresentTarget> targets;
+};
+
+Map& GetMap() {
+  static base::NoDestructor<Map> map;
+  return *map;
+}
+
+}  // namespace
+
+void X11ReadbackPresentCache::Register(gfx::AcceleratedWidget widget,
+                                       const X11ReadbackPresentTarget& target) {
+  auto& map = GetMap();
+  base::AutoLock lock(map.lock);
+  map.targets[widget] = target;
+}
+
+void X11ReadbackPresentCache::Unregister(gfx::AcceleratedWidget widget) {
+  auto& map = GetMap();
+  base::AutoLock lock(map.lock);
+  map.targets.erase(widget);
+}
+
+bool X11ReadbackPresentCache::Lookup(gfx::AcceleratedWidget widget,
+                                     X11ReadbackPresentTarget* out) {
+  auto& map = GetMap();
+  base::AutoLock lock(map.lock);
+  auto it = map.targets.find(widget);
+  if (it == map.targets.end()) {
+    return false;
+  }
+  *out = it->second;
+  return true;
+}
+
+bool X11ReadbackPresentCache::Contains(gfx::AcceleratedWidget widget) {
+  auto& map = GetMap();
+  base::AutoLock lock(map.lock);
+  return map.targets.contains(widget);
+}
+
+}  // namespace ui
