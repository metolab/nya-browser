 void SublevelManager::OnWidgetChildAdded(Widget* owner, Widget* child) {
-  CHECK_EQ(owner, owner_);
-  CHECK(!std::ranges::contains(children_, child));
-  CHECK_EQ(child->parent(), owner_);
+  // Nya hosts extra UI on one GPU compositor. CreateNativeWidget may attach
+  // params.parent after Widget::parent_ was bound, so Init both reparents
+  // (OnChildAdded) and then notifies again at the end of Init. A CHECK here
+  // kills the whole browser because --in-process-gpu shares the process.
+  if (owner != owner_) {
+    LOG(ERROR) << "nya-widget child-added owner mismatch observer="
+               << DescribeWidget(owner_) << " notify=" << DescribeWidget(owner)
+               << " child=" << DescribeWidget(child);
+    return;
+  }
+  if (!child) {
+    LOG(ERROR) << "nya-widget child-added null child owner="
+               << DescribeWidget(owner_);
+    return;
+  }
+  if (std::ranges::contains(children_, child)) {
+    LOG(ERROR) << "nya-widget child-added duplicate owner="
+               << DescribeWidget(owner_) << " child=" << DescribeWidget(child);
+    return;
+  }
+  if (child->parent() != owner_) {
+    LOG(ERROR) << "nya-widget child-added parent mismatch owner="
+               << DescribeWidget(owner_) << " child=" << DescribeWidget(child);
+    return;
+  }
   children_.push_back(child);
 }
 
 void SublevelManager::OnWidgetChildRemoved(Widget* owner, Widget* child) {
-  CHECK_EQ(owner, owner_);
+  if (owner != owner_) {
+    LOG(ERROR) << "nya-widget child-removed owner mismatch observer="
+               << DescribeWidget(owner_) << " notify=" << DescribeWidget(owner)
+               << " child=" << DescribeWidget(child);
+    return;
+  }
   // During shutdown a child might get untracked more than once by the same
   // parent. We don't want to DCHECK on that.
   std::erase(children_, child);
