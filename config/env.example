# Copy to repo root as `.env` before `docker compose up`.
#   cp config/env.example .env

# --- required ---
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=change-me

# --- listen / host paths ---
HOST=0.0.0.0
PORT=8080
NYA_PORT=8080
NYA_DATA_DIR=./data
NYA_IMAGE_TAG=latest
# Public URL prefix. Default /. Example: /nya-browser (no trailing slash).
# Reverse proxies must keep this prefix (do not strip it) and upgrade WebSockets.
# BASE_PATH=/

# --- paths inside the container ---
DATA_DIR=/data
STATIC_DIR=/app/frontend/dist
CHROME_BIN=/opt/nya-chromium/chrome
# DB_PATH=/data/nya.db

# --- auth ---
# AUTH_TTL_MS=604800000
# LOGIN_RATE_LIMIT=80

# --- logging ---
LOG_LEVEL=info

# --- GPU (use with docker-compose.gpu.yml) ---
# NYA_GPU=1
# NYA_GPU_BACKEND=gl-egl   # gl-egl | gles-egl | vulkan | swiftshader

# --- session runtime (optional) ---
# DISPLAY_BASE=100
# SUB_DISPLAY_BASE=2000
# MAX_SUBS=8
# VNC_PORT_BASE=5900
# LOCAL_PROXY_BASE=18000
# SLOT_UID_BASE=12000
# SCREEN_SIZE=1920x1080x24
# NYA_CDP_BASE=19200

# --- proxy probe (optional) ---
# PROXY_TEST_URL=https://cp.cloudflare.com/cdn-cgi/trace
# PROXY_TEST_TIMEOUT_MS=12000

# --- image build (docker-compose.dev.yml) ---
# NYA_GITHUB_REPO=metolab/nya-browser
# CHROMIUM_URL=
